  "regime_transition_notes": {
    "silent_same_context_lock_in_b2_star": {
      "summary": "When optimal actions invert with zero context shift (Exp 96B Phase B2_silent), hands-off latent belief locks onto the archived Regime-A policy at 1.0% late accuracy (0.67% full B2_silent accuracy) because context novelty remains low.",
      "exp96b_native_b2_last20_acc_n15": 0.01,
      "exp96b_policy_reset_b2_last20_acc_n8": 0.0125,
      "companion_exp85a1_failure_triggered_reset_cure": {
        "design": "Controlled 2-arm noiseless 10x same-context reward inversion at step 50 (n=10 paired seeds); self-surprise trigger (chosen_score >= 0.75 and realized reward <= 0.25 for 2 consecutive steps) calls POST /policy/reset.",
        "no_reset_reg_b_late_acc": 0.0,
        "policy_reset_reg_b_late_acc": 0.9733,
        "policy_reset_recovered_seeds": "10/10",
        "policy_reset_mean_steps_to_3x_recovery": 5.6,
        "policy_reset_mean_latency_ms": 154.04,
        "architectural_tradeoff": "Explicit failure-triggered POST /policy/reset cures one-way silent lock-in (0.0% -> 97.3%) but wipes archived contextual policy state, destroying zero-shot recurrence if fired before a regime returns (Exp 96B A2 first-10 drops 78.8% -> 23.8%)."
      }
    },
    "hard_flush_tail_starvation_on_noisy_markets": {
      "summary": "On noisy real financial streams (Exp 79A / Exp 85B-2), hard 21-day drift-triggered domain flushes (8 rotations) starve empirical 99% tail resolution and degrade both Energy Score (1.34525 -> 1.36707, weekly Holm p=0.0189) and simulated 5 bps return (-2.25% -> -5.95%, MaxDD -19.61% -> -22.55%) relative to smooth W=128 retention."
    },
    "no_significance_on_5phase_regret_vs_adwin_hgbr": {
      "summary": "Across all 5 phases including B2_silent, Adapt-1 Native ties ADWIN_Online_HGBR on cumulative regret (136.70 vs 136.37, p_holm=0.9341) because B2_silent lock-in offsets Adapt-1's statistically significant sweep over all 8 peers across observable recurring phases A1..A2 (89.25 vs 101.00, p_holm=0.0076)."
    }
  },
